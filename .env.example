# Google Drive import
# Create a Google OAuth 2.0 Web client in Google Cloud and enable the Google Drive API.
# Authorized JavaScript origin: https://alpha-ai-techstudio7808-4455.vercel.app
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Existing Alpha.ai runtime variables are configured in Vercel and the selected worker host.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-side aliases: keep the existing deployed variable name; set one secret key only.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker-only Gemini configuration. Never prefix these keys with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Optional comma-separated rotation pool, in addition to numbered keys.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Optional distributed API rate limiting; database-backed fallback remains available.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MEDIA_WORKER_URL=
# Shared with the worker; required for queued cloud-source credential encryption.
MEDIA_WORKER_SECRET=

# YouTube publishing OAuth
YOUTUBE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-web-client-secret
YOUTUBE_REDIRECT_URI=https://alpha-ai-techstudio7808-4455.vercel.app/api/publish/callback
OAUTH_STATE_SECRET=replace-with-long-random-secret
# Lifecycle email
RESEND_API_KEY=your-resend-api-key
LIFECYCLE_FROM_EMAIL=Alpha.ai <noreply@your-verified-domain>
# Cron authentication
CRON_SECRET=replace-with-long-random-secret
INDEXNOW_SECRET=replace-with-long-random-secret

# Canonical URL only; this does not change the Vercel project domain.
NEXT_PUBLIC_SITE_URL=https://alpha-ai-techstudio7808-4455.vercel.app
# Worker-only optional controls (also documented in worker/README.md).
TRANSCRIPTION_PROVIDER=gemini
MAX_DOWNLOAD_MB=512
MAX_JOB_DISK_MB=2048

# Instagram Graph API OAuth (Meta for Developers)
INSTAGRAM_APP_ID=<your-meta-app-id>
INSTAGRAM_APP_SECRET=<your-meta-app-secret>
INSTAGRAM_REDIRECT_URI=https://alpha-ai-techstudio7808-4455.vercel.app/api/publish/callback?provider=instagram

# Storage Retention Policy (Days per plan)
RETENTION_DAYS_FREE=7
RETENTION_DAYS_PRO=30
RETENTION_DAYS_STUDIO=90


# Manual UPI billing (amounts are paise; set only the plans actually offered).
UPI_VPA=
UPI_PAYEE_NAME=Alpha.ai
UPI_PRICE_PRO_MONTHLY_PAISE=
UPI_PRICE_PRO_YEARLY_PAISE=
UPI_PRICE_STUDIO_MONTHLY_PAISE=
UPI_PRICE_STUDIO_YEARLY_PAISE=
