# Google Drive import
# Create a Google OAuth 2.0 Web client in Google Cloud and enable the Google Drive API.
# Authorized JavaScript origin: https://alpha-ai-techstudio7808-4455.vercel.app
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Existing Alpha.ai runtime variables are configured in Vercel/Render.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
MEDIA_WORKER_URL=https://alpha-ai-media-worker.onrender.com
# Optional when the worker can validate the forwarded Supabase access token.
MEDIA_WORKER_SECRET=

# YouTube publishing OAuth
YOUTUBE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-web-client-secret
YOUTUBE_REDIRECT_URI=https://alpha-ai-techstudio7808-4455.vercel.app/api/publish/callback
OAUTH_STATE_SECRET=replace-with-long-random-secret
# Lifecycle email
RESEND_API_KEY=your-resend-api-key
LIFECYCLE_FROM_EMAIL=Alpha.ai <noreply@your-verified-domain>
# Cron authentication
CRON_SECRET=replace-with-long-random-secret
INDEXNOW_SECRET=replace-with-long-random-secret
